{% import 'app/macro.html.twig' as m %}


{% set entity = category is defined ? category :
                article is defined ? article :
                product is defined ? product :
                null
%}

<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
        {{ encore_entry_script_tags('js') }}
        {{ encore_entry_script_tags('js-socket') }}
        {{ encore_entry_script_tags('js-slider') }}
        {% block stylesheets %}
            {{ encore_entry_link_tags('style') }}
        {% endblock %}
        {% block javascripts %}{% endblock %}
    </head>
    <body data-controller="ecommerce popup">
        {% block header %}
            <header>
                {% include 'app/_inc/_menu.html.twig' %}
{#                {% block slider %}#}
{#                    {% include '_header' %}#}
{#                {% endblock %}#}
            </header>
        {% endblock %}

{#        {% block slider %}{% endblock %}#}
            {% block svgs %}{% endblock %}
            {% block intro %}{% endblock %}
        <div class="section">
            {% if hasBreadcrumb(app.request.get('_route')) %}
                {{ m.breadcrumb(entity) }}
            {% endif %}
            {% block content %}{% endblock %}
        </div>

        <div class="popup-background"></div>
        <div class="popup-container" data-controller="form-collection">
            <div>
                <div class="popup-view"></div>
                <button class="bn bn-primary" id="btn-add" {{ stimulus_action('popup', 'popupActionElement') }}>{{ "form.validate"|trans }}</button>
                <button id="btn-close" class="bn bn-primary" {{ stimulus_action('popup', 'popupCloseFormElement') }}>{{ "form.close"|trans }}</button>
            </div>
        </div>

{#        <div class="main">#}
{#            <div class="container my-5 ">#}
{#               #}
{#                {% block content %}#}
{#                {% endblock %}#}
{#            </div>#}
{#        </div>#}

        {% block footer %}
            {% include 'app/_inc/_footer.html.twig' %}
        {% endblock %}
    </body>
</html>
