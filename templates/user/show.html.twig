{% extends "app/user/base_user.html.twig" %}
{% import 'app/macro.html.twig' as m %}

{% block user_content %}
    <section class="section">
        {{ form_start(form) }}
        {{ form_row(form.username) }}
        {{ form_row(form.email) }}
        <div>
            <button class="bn bn-primary" {{ stimulus_action('profile', 'editPasswordElement') }}>
                <i class="fa-solid fa-pen"></i>{{ "profile.password.change"|trans }}
            </button>
            <div class="div-edit-password">
                <label class="form-lab" for="oldpassword">{{ "profile.password.old"|trans }}</label>
                <input class="form-inp" type="password" name="oldpassword" id="oldpassword">
                {{ form_row(form.password.first) }}
                {{ form_row(form.password.second) }}
            </div>
        </div>
        <div>
            <div class="user-table table-choices">
                {% for a in user.addresses %}
                    <div class="cart list-item">
                        <div class="item-infos">
                            <h2>{{ a.label }}</h2>
                            <span><span class="lighten">{{ a.phone }}</span><br>
                            {{ a.address }}<br>
                            {{ a.code }}, {{ a.city|upper }}</span>
                        </div>
                        <div class="address-actions">
                            <a href="{{ path('app_user_address_edit', {'id' : a.id }) }}"><i class="fa-solid fa-pen"></i></a>
                            <a href="{{ path('app_user_address_delete', {'id' : a.id }) }}"><i class="fa-solid fa-trash"></i></a>
                        </div>
                    </div>
                    <hr>
                {% endfor %}
            </div>
        </div>
        <div class="btn-container">
            <a  href="{{ path('app_user_address_add') }}" class="bn bn-primary"><i class="fa-solid fa-plus"></i> {{ "commerce.addAddress"|trans }}</a>
        </div>
        <button type="submit" class="bn-primary bn">{{ "form.edit"|trans }}</button>
        {{ form_end(form) }}
    </section>
{% endblock %}