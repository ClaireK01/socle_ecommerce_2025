{% extends "base_admin.html.twig" %}
{% trans_default_domain 'admin' %}
{% import 'admin/macro.html.twig' as m %}

{% block content %}

    <div class="container show-order">

        {{ m.orderDetails(entity) }}


        <table class="table">
            {% if entity %}
                {{ m.orderDisplay(entity) }}
            {% endif %}
        </table>

        <div class="order-manager">
            <div class="order-details order-state">
                <h3>{{ "order.status"|trans }}</h3>
                <form method="POST">
                    <select id="state" name="state">
                        {% for key, s in constant('App\\Entity\\EcommerceOrder::STATES') %}
                            <option value="{{ s }}" {{ entity.status == s ? "selected" : '' }}>{{ ("order.states."~key)|trans }}</option>
                        {% endfor %}
                    </select>
                    <button type="submit" class="bn bn-success">{{ "order.changeState"|trans }}</button>
                </form>
            </div>

            <div class="order-details order-shipping">
                <h3>{{ "order.address"|trans }}</h3>
                <p>
                    <span>{{ entity.shipping.translate.title|raw }}</span><br>
                    <span>{{ entity.shipping.price }} €</span>
                </p>
            </div>

            <div class="order-details order-shipping">
                <h3>{{ "order.payment"|trans }}</h3>
                <p>
                    <span>{{ entity.paymentMethod.translate.title }}</span><br>
                </p>
            </div>
        </div>

        <a href="{{ path(app.request.get('_route')|replace({'show' : 'index'})) }}"><button>{{ "all.back"|trans }}</button></a>

    </div>

    </div>
{% endblock %}
