{% extends "base_admin.html.twig" %}
{% trans_default_domain 'admin' %}

{% block content %}
    {% set table = getAdminTable(entity, app.request) %}

    <div class="container">
        <table class="table table-show">
            <tbody>
                {% for key , value in table %}
                    {% if key != "createdAt" and key != "deletedAt" and key != "updatedAt"%}
                        <tr><td>{{ key }}</td><td>{{ value|raw }}</td></tr>
                    {% endif %}
                {% endfor %}
            </tbody>
        </table>

        <div>
            <a href="{{ path(app.request.get('_route')|replace({'show' : 'index'})) }}"><button>{{ "all.back"|trans }}</button></a>
        </div>
    </div>
{% endblock %}
