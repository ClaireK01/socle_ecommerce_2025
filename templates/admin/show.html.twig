{% extends "base_admin.html.twig" %}
{% trans_default_domain 'admin' %}

{% block body %}
    {% set table = getAdminTable(entity, app.request) %}

    <div class="container">
        <table>
            <tbody>
                {% for key , value in table %}
                    {% if key != "createdAt" and key != "deletedAt" and key != "updatedAt"%}
                        <tr><td>{{ key }}</td><td>{{ value }}</td></tr>
                    {% endif %}
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
