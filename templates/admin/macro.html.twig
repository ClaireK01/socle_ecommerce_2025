{% trans_default_domain 'admin' %}

{% macro orderDetails(order) %}
    <div class="order-details order-details-top">
        <h2>{{ "order.details"|trans }}</h2>
        <p><span class="bold">{{ "order.number"|trans }}</span> : {{ order.number }}</p>
        <p><span class="bold">{{ "order.name"|trans }}</span>  : {{ order.shippingAddress.firstName }} {{ order.shippingAddress.lastName|upper }}</p>
        <p><span class="bold">{{ "order.email"|trans }} </span> : {{ order.shippingAddress.user.email }}</p>
        <p><span class="bold">{{ "order.phone"|trans }} </span> : {{ order.shippingAddress.phone }}</p>
        <p><span class="bold">{{ "order.street"|trans }}</span>  : {{ order.shippingAddress.address }}</p>
        <p><span class="bold">{{ "order.city"|trans }} </span> : {{ order.shippingAddress.code }} {{ order.shippingAddress.city|upper }}</p>
    </div>
{% endmacro %}

{% macro orderDisplay(order) %}
    {% if order.cardProducts|length > 0 %}
        <thead>
            {{ _self.orderHeader() }}
        </thead>
        <tbody>
        {% for c in order.cardProducts %}
            {{ _self.orderLine(c) }}
        {% endfor %}
        {{ _self.orderLineTotal(order) }}
        </tbody>
    {% endif %}
{% endmacro %}
{% macro orderHeader() %}
    <tr class="product list-item">
        <th></th>
        <th>{{ "order.product"|trans }}</th>
        <th>{{ "order.quantity"|trans }}</th>
        <th>{{ "order.unitPriceHT"|trans }}</th>
        <th>{{ "order.unitPrice"|trans }}</th>
        <th>{{ "order.priceHT"|trans }}</th>
        <th>{{ "order.priceTTC"|trans }}</th>
        <th></th>
    </tr>
{% endmacro %}

{% macro orderLine(c) %}
    <tr class="product list-item">
        <td>
            <a href="{{ path('app_product_show', {'id' : c.product.id}) }}">
                <div class="card-product-img"></div>
            </a>
        </td>
        <td>{{ c.product.translate.title }}</td>
        <td>{{ c.quantity }}</td>
        <td>{{ c.priceHt|number_format(2, ',', ' ') }}€</td>
        <td>{{ c.price|number_format(2, ',', ' ') }}€</td>
        <td>{{ c.finalPriceHt|number_format(2, ',', ' ') }}€</td>
        <td>{{ c.finalPriceTtc|number_format(2, ',', ' ') }}€</td>
    </tr>
{% endmacro %}

{% macro orderLineTotal(order) %}
    <tr class="product list-item">
        <td></td>
        <td>Total</td>
        <td>{{ order.totalQuantity }}</td>
        <td>{{ order.totalUnitaireHt|number_format(2, ',', ' ') }}€</td>
        <td>{{ order.totalUnitaireTtc|number_format(2, ',', ' ') }}€</td>
        <td>{{ order.totalHt|number_format(2, ',', ' ') }}€</td>
        <td>{{ order.totalTtc|number_format(2, ',', ' ') }}€</td>
        <td></td>
    </tr>
{% endmacro %}