{% extends 'base.html.twig' %}
{% import 'app/macro.html.twig' as m %}


{% block content %}
    <div class="main">
        <div class="container my-5">
            <div class="product-show">
                <div class="product-img"></div>
                <div class="product-descr">
                    <h3>{{ product.translate.title }}</h3>
                    <p>{{ product.translate.content|raw }}</p>
                    <p class="price-tag"><span class="price-tag-num" data-price="{{ product.price }}">{{ product.price|number_format(2, ',', ' ') }}</span><span class="price-tag-currency">€</span></p>
                    <div class="add-container">
                        <div class="quantity-container">
                            <button value="minus" class="btn-quant" data-ecommerce-target="quantbutton">
                                <i class="fa-solid fa-minus"></i>
                            </button>
                            <input type="number" min="1" value="{{ getQuantityProductCart(cart, product) }}" data-ecommerce-target="quantity" class="quantity" data-show="1">
                            <button class="btn-quant" value="plus" data-ecommerce-target="quantbutton">
                                <i class="fa-solid fa-plus"></i>
                            </button>
                        </div>
                        <button class="btn btn-warning add-cart" data-ecommerce-target="cart" data-add="{{ path('add_to_cart', {'id' : product.id}) }}"><i class="fa-solid fa-cart-plus"></i> Ajouter au panier</button>
                    </div>
                </div>
            </div>

            <div class="similar">
                <h2>{{ "product.seealso"|trans }}</h2>
                {{ m.slider("product", similarProducts, cart) }}
            </div>
        </div>
    </div>
{% endblock %}