{% extends 'base.html.twig' %}
{% import 'app/macro.html.twig' as m %}


{% block body %}
    <h2 class="title">{{ "commerce.category.see"|trans }}</h2>
    <div class="list">
        {% for category in pagination %}
            {% if category.parent is null %}
                {{ m.cardCategory(category) }}
            {% endif %}
        {% endfor %}
    </div>
    {{ knp_pagination_render(pagination) }}
{% endblock %}