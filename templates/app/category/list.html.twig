{% extends 'base.html.twig' %}
{% import 'app/macro.html.twig' as m %}


{% block body %}
    <div class="main">
        <div class="container my-5 ">
            <h2 class="title">{{ "commerce.category.see"|trans }}</h2>
            <div class="list">
                {% for category in pagination %}
                    {{ m.cardCategory(category) }}
                {% endfor %}
            </div>

            {{ knp_pagination_render(pagination) }}
        </div>
    </div>
{% endblock %}