{% extends 'base.html.twig' %}
{% import 'app/macro.html.twig' as m %}


{% block body %}
    <h2 class="title">{{ "commerce.product.listCat"|trans }} {{ category.translate.title}}</h2>
    <div class="list">
        {% for product in pagination %}
            {{ m.cardProduct(product, cart) }}
        {% endfor %}
    </div>

    {{ knp_pagination_render(pagination) }}
{% endblock %}