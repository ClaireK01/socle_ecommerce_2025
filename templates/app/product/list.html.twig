{% extends 'base.html.twig' %}
{% import 'app/macro.html.twig' as m %}


{% block body %}
    <div class="main">
        <div class="container my-5 ">
            <div class="product-list">
                {% for product in products %}
                    {{ m.cardProduct(product) }}
                {% endfor %}
            </div>

            {{ knp_pagination_render(products) }}
        </div>

    </div>
{% endblock %}