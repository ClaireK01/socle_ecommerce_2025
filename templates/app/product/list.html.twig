{% extends 'base.html.twig' %}
{% import 'app/macro.html.twig' as m %}


{% block content %}
    <section class="section">
        {% if pagination|length > 0 %}
            <h2 class="title">{{ "commerce.product.listCat"|trans }}</h2>
            <div class="list-container">
                {{ m.filter(productAttributes, category) }}
                <div class="list-view" style="width: 100%">
                    <div class="list">
                        {% for product in pagination %}
                            {{ m.cardProduct(product, cart) }}
                        {% endfor %}
                    </div>
                    {{ knp_pagination_render(pagination) }}
                </div>
            </div>
        {% else %}
            <div>{{ 'commerce.noproduct'|trans }}</div>
        {% endif %}
    </section>
{% endblock %}