{% extends 'base.html.twig' %}
{% import 'app/macro.html.twig' as m %}


{% block content %}
    <div class="product-show">
        <div class="product-img" style="background-image: url({{ asset(product.firstPicture.path) }})"></div>
        <div class="product-descr">
            <h3>{{ product.translate.title }}</h3>
            <p>{{ product.translate.content|raw }}</p>
            <div class="attribute-container">
                {% for key, productAttr in productAttributes %}
                    <h4 class="small-title">{{ key }}</h4>
                    <div class="attributes">
                        {% for attr in productAttr  %}
                            {{ m.attributes(attr) }}
                        {% endfor %}
                    </div>
                {% endfor %}
            </div>
            <p class="price-tag" data-url="{{ path('product_price_attribute', {'id': product.id}) }}"><span class="price-tag-num" data-price="{{ product.price }}">{{ product.price|number_format(2, ',', ' ') }}</span><span class="price-tag-currency">€</span></p>
            <div class="add-container">
                <div class="quantity-container">
                    <button value="minus" class="btn-quant" data-ecommerce-target="quantbutton">
                        <i class="fa-solid fa-minus"></i>
                    </button>
                    <input type="number" min="1" value="1" data-ecommerce-target="quantity" class="quantity" data-show="1">
                    <button class="btn-quant" value="plus" data-ecommerce-target="quantbutton">
                        <i class="fa-solid fa-plus"></i>
                    </button>
                </div>
                <div class="display-none" data-list-attr=""></div>
                <button class="bn bn-primary add-cart" data-ecommerce-target="cart" data-add="{{ path('add_to_cart', {'id' : product.id}) }}">{{ "commerce.add"|trans }}</button>
            </div>
        </div>
    </div>

    <div class="similar">
        <h2>{{ "product.seealso"|trans }}</h2>
        {{ m.slider("product", similarProducts, cart) }}
    </div>
{% endblock %}