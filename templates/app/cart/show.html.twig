{% extends 'base.html.twig' %}
{% import 'app/macro.html.twig' as m %}


{% block body %}
        <h1>{{ 'commerce.cart'|trans }}</h1>
        <hr>

        {# transformer en tableau #}
        <table class="table-products">
           {{ m.cartDisplay(cart) }}
        </table>
        {% if cart != null and cart.cardProducts|length > 0 %}
            <div class="cart-next">
                <a class="btn btn-warning" href="{{ path('ecommerce_address') }}">{{ 'all.next'|trans }}</a>
            </div>
        {% endif %}
{% endblock %}
