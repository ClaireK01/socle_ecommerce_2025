{% extends 'base.html.twig' %}
{% import 'app/macro.html.twig' as m %}


{% block body %}
<div class="main">
    <div class="container my-5">
        <h1>{{ 'commerce.cart'|trans }}</h1>
        <hr>

        {# transformer en tableau #}
        <div class="table-products">
            {% if cart %}
                {% if cart.cardProducts|length > 0 %}
                    {% for c in cart.cardProducts %}
                         {{ m.cartLine(c) }}
                    {% endfor %}
                    {{ m.cartLineTotal(cart) }}
                {% else %}
                        <p>{{ "commerce.empty"|trans }}</p>
                {% endif %}
            {% endif %}
        </div>

        {% if cart.cardProducts|length > 0 %}
            <a class="btn btn-warning" href="{{ path('ecommerce_address') }}">{{ 'all.next'|trans }}</a>
        {% endif %}
    </div>
</div>
{% endblock %}
