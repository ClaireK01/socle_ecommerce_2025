{% extends 'base.html.twig' %}


{% block content %}
<div class="main">
    <div class="container my-5">
        {% if type == "ship" %}
            <h2>{{ "commerce.adress.shipping"|trans }}</h2>
        {% else %}
            <h2>{{ "commerce.adress.facturation"|trans }}</h2>
        {% endif %}        <hr>
        {% if user is not  null %}
            {% if user.addresses|length > 0 %}
                <div>
                    <form class="table-choices" action="#" method="POST">
                        {% for a in user.addresses %}
                            <div class="cart list-item">
                                <input type="radio" id="{{ a.id }}" name="address" value="{{ a.id }}">
                                <div class="item-infos">
                                    <label for="{{ a.id }}" class="display-none">{{ a.label }}</label>
                                    <h2>{{ a.label }}</h2>
                                    <span><span class="lighten">{{ a.phone }}</span><br>
                                    {{ a.address }}<br>
                                    {{ a.code }}, {{ a.city|upper }}</span>
                                </div>
                            </div>
                            <hr>
                        {% endfor %}
                        {% if type == "ship" %}
                            <input name="same_address" id="same_address" type="checkbox"><label for="same_address">{{ "commerce.adress.sameadress"|trans }}</label>
                        {% endif %}
                        <a class="bn bn-primary" href="{{ path('ecommerce_cart') }}">{{ 'all.previous'|trans }}</a>
                        <button type="submit" class="bn bn-primary">{{ 'all.next'|trans }}</button>
                    </form>
                </div>
            {% else %}
                <div class="btn-container">
                    <a  href="{{ path('ecommerce_address_add') }}" class="bn bn-primary"><i class="fa-solid fa-plus"></i> {{ "commerce.addAddress"|trans }}</a>
                    <a class="bn bn-primary" href="{{ path('ecommerce_cart') }}">{{ 'all.previous'|trans }}</a>
                </div>
            {% endif %}
        {% else %}
            {{ form_start(form) }}
            <div>
                {{ form_widget(form) }}
                {% if type == "ship" %}
                    <input name="same_address" id="same_address" type="checkbox"><label for="same_address">{{ "commerce.adress.sameadress"|trans }}</label>
                {% endif %}
            </div>
            <div class="btn-container">
                {% if type == "ship" %}
                    <a class="bn bn-primary" href="{{ path('ecommerce_cart') }}">{{ 'all.previous'|trans }}</a>
                {% else %}
                    <a class="bn bn-primary" href="{{ path('ecommerce_address') }}">{{ 'all.previous'|trans }}</a>
                {% endif %}
                <button type="submit" class="bn bn-primary">{{ "all.next"|trans }}</button>
            </div>
            {{ form_end(form) }}
        {% endif %}
    </div>
</div>
{% endblock %}
