{% extends 'base.html.twig' %}


{% block content %}
    <div class="main">
        <div class="container my-5">
            <h1>{{ 'commerce.profile.addAddress'|trans }}</h1>
            <hr>

            {{ form_start(form) }}
                {{ form_widget(form) }}
            {% set previous = type is defined and type == "profile" ? path('app_user') : path('ecommerce_address') %}
                <a href="{{ previous }}" class="bn bn-primary">{{ 'all.previous'|trans }}</a>
                <button type="submit" class="bn bn-primary">{{ 'form.add'|trans }}</button>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
