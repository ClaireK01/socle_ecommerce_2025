{% extends 'base.html.twig' %}
{% import 'app/macro.html.twig' as m %}


{% block content %}
<div class="main">
    <div class="container my-5">
        <h1>{{ 'commerce.summary'|trans }}</h1>
        <hr>
        <table class="table-products">
            {% if cart %}
                {{ m.cartDisplay(cart) }}
            {% endif %}
        </table>

        <div class="order-infos">
            <div class="address card-order-infos">
                <span class="small-title">{{ 'commerce.adress.shipping'|trans }}</span>
                <h3>{{ address.label ?: 'commerce.adress.shipping'|trans }}</h3>
                <div>
                    <span><span class="lighten">{{ address.phone }}</span><br>
                        {{ address.address }}<br>
                        {{ address.code }}, {{ address.city|upper }}</span>
                </div>
            </div>
            <div class="address card-order-infos">
                <span class="small-title">{{ 'commerce.adress.facturation'|trans }}</span>
                <h3>{{ addressfac.label ?: 'commerce.adress.facturation'|trans }}</h3>
                <div>
                    <span><span class="lighten">{{ addressfac.phone }}</span><br>
                        {{ addressfac.address }}<br>
                        {{ addressfac.code }}, {{ addressfac.city|upper }}</span>
                </div>
            </div>
            <div class="shipping card-order-infos">
                <span class="small-title">{{ 'commerce.shipping'|trans }}</span>
                <h3>{{ shipping.translate.title }}</h3>
                <p>{{ shipping.translate.shortContent }}</p>
            </div>
            <div class="payment card-order-infos">
                <span class="small-title">{{ 'commerce.payment'|trans }}</span>
                <h3>{{ payment.translate.title }}</h3>
                <p>{{ payment.translate.shortContent }}</p>
            </div>
        </div>
        <a class="bn bn-primary" href="{{ path('ecommerce_payment') }}">{{ 'all.previous'|trans }}</a>
        <a class="bn bn-primary" href="{{ path('ecommerce_validate') }}">{{ 'commerce.validate'|trans }}</a>
    </div>
</div>
{% endblock %}
