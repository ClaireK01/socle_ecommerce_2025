{% macro slider(type, array) %}
    <div class="swiper-{{type}} swiper-container">
        <div class="swiper-wrapper">
            {% for entity in array%}
                <div class="swiper-slide">
                    {% if type == "product" %}
                        {{ _self.cardProduct(entity) }}
                    {% elseif type == "article" %}
                        {{ _self.cardArticle(entity) }}
                    {% endif %}
                </div>
            {% endfor %}
        </div>
        <div class="swiper-pagination-{{type}}"></div>
        <div class="swiper-button-prev"></div>
        <div class="swiper-button-next"></div>
    </div>
{% endmacro %}

{% macro cardProduct(product) %}
    <div class="card-product">
        <div class="card-product-img"></div>
        <div class="card-product-descr">
            <p>{{ product.translate.title }}</p>
            <p>{{ product.translate.shortContent }}</p>
            <p>{{ product.price }}€</p>
        </div>
        <div>
            <a class="btn btn-warning add-cart" href="{{ path('app_product_show', {'id' : product.id}) }}">{{ "all.show"|trans }}</a>
            <button class="btn btn-warning add-cart" data-ecommerce-target="cart" data-add="{{ path('add_to_cart', {'id' : product.id}) }}">{{ "commerce.add"|trans }}</button>
        </div>
    </div>
{% endmacro %}

{% macro cardArticle(article) %}
    <div class="card-article">
        <div class="card-article-img"></div>
        <div>
            <div class="card-article-descr">
                <p>{{ article.translate.title }}</p>
                <p>{{ article.translate.shortContent }}</p>
                <a class="btn btn-warning" href="{{ path('app_article_show', {'id' : article.id}) }}">{{ "all.read"|trans }}</a>
            </div>
        </div>
    </div>
{% endmacro %}

{% macro cartLine(c) %}
    <div class="product list-item">
        <div class="card-product-img"></div>
        <div class="card-product-line">
            <p>{{ c.product.translate.title }}</p>
            <p>{{ c.quantity }}</p>
            <p>{{ c.price|number_format(2, ',', ' ') }}€</p>
            <p>{{ c.finalPriceHt|number_format(2, ',', ' ') }}€</p>
            <p>{{ c.finalPriceTtc|number_format(2, ',', ' ') }}€</p>
        </div>
    </div>
    <hr>
{% endmacro %}

{% macro cartLineTotal(cart) %}
    <div class="product list-item">
        <div class="card-product-line">
            <p>Total</p>
            <p>{{ cart.totalQuantity }}</p>
            <p>{{ cart.totalUnitaire|number_format(2, ',', ' ') }}€</p>
            <p>{{ cart.totalHt|number_format(2, ',', ' ') }}€</p>
            <p>{{ cart.totalTtc|number_format(2, ',', ' ') }}€</p>
        </div>
    </div>
    <hr>
{% endmacro %}