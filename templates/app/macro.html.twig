{% macro slider(type, array, cart, size = null) %}
    <div class="swiper-{{ type }} swiper-container">
        <div class="swiper-wrapper">
            {% for entity in array %}
                <div class="swiper-slide">
                    {% if type == "product" %}
                        {{ _self.cardProduct(entity) }}
                    {% elseif type == "article" %}
                        {{ _self.cardArticle(entity) }}
                    {% elseif type == "carousel" %}
                        {{ _self.carousel(entity, size) }}
                    {% endif %}
                </div>
            {% endfor %}
        </div>
        <div class="swiper-pagination-{{ type }}"></div>
        <div class="swiper-button-prev"></div>
        <div class="swiper-button-next"><div>
    </div>
{% endmacro %}

{% macro cardProduct(product) %}
    <div class="card-product" data-ecommerce-target="link" data-link="{{ path('app_product_show', {'id' : product.id}) }}">
        <div class="card-product-img" style="background-image: url({{ asset(product.firstPicture.path) }})"></div>
        <div class="card-product-descr">
            <h3>{{ product.translate.title }}</h3>
            <p>{{ product.translate.shortContent }}</p>
            <p>{{ product.price|number_format(2, ',', ' ') }}€</p>
        </div>
        <div class="card-bottom">
            <div class="add-container">
                <div class="quantity-container">
                    <button value="minus" class="btn-quant" data-ecommerce-target="quantbutton">
                        <i class="fa-solid fa-minus"></i>
                    </button>
                  <input type="number" min="1" value="1" class="quantity" data-ecommerce-target="quantity">
                    <button class="btn-quant" value="plus" data-ecommerce-target="quantbutton">
                        <i class="fa-solid fa-plus"></i>
                    </button>
                </div>
                <button class="bn bn-primary add-cart" data-ecommerce-target="cart" data-add="{{ path('add_to_cart', {'id' : product.id}) }}"><i class="fa-solid fa-cart-plus"></i></button>
            </div>
        </div>
    </div>
{% endmacro %}

{% macro cardArticle(article) %}
    <div class="card-article"  data-ecommerce-target="link" data-link="{{ path('app_article_show', {'id' : article.id}) }}">
        <div class="card-article-img" style="background-image: url('{{ asset(article.firstPicture.path) }}')"></div>
        <div>
            <div class="card-article-descr">
                <p>{{ article.translate.title }}</p>
                <p>{{ article.translate.shortContent }}</p>
                <a class="bn bn-primary" href="{{ path('app_article_show', {'id' : article.id}) }}">{{ "all.read"|trans }}</a>
            </div>
        </div>
    </div>
{% endmacro %}

{% macro cartDisplay(cart) %}
    {% if cart != null and cart.cardProducts|length > 0 %}
        <thead>
        {{ _self.cartHeader() }}
        </thead>
        <tbody>
        {% for c in cart.cardProducts %}
            {{ _self.cartLine(c) }}
        {% endfor %}
        {{ _self.cartLineTotal(cart) }}
        </tbody>
    {% else %}
        <p>{{ "commerce.empty"|trans }}</p>
    {% endif %}
{% endmacro %}
{% macro cartHeader() %}
    <tr class="product list-item">
        <th></th>
        <th>{{ "cart.product"|trans }}</th>
        <th>{{ "cart.quantity"|trans }}</th>
        <th>{{ "cart.unitPriceHT"|trans }}</th>
        <th>{{ "cart.unitPrice"|trans }}</th>
        <th>{{ "cart.priceHT"|trans }}</th>
        <th>{{ "cart.priceTTC"|trans }}</th>
        <th></th>
    </tr>
{% endmacro %}

{% macro cartLine(c) %}
    <tr class="product list-item">
        <td>
            <a href="{{ path('app_product_show', {'id' : c.product.id}) }}">
                <div class="card-product-img"></div>
            </a>
        </td>
        <td>
            {{ c.product.translate.title }}<br>
            {% for ca in c.cardAttributes %}
                <span class="small-title">{{ ca.translate.productAttributeTitle|trans ~ " : " ~ca.translate.title|trans }}</span><br>
            {% endfor %}
        </td>
        <td><input data-ecommerce-target="quantity" type="number" class="qty" value="{{ c.quantity }}" data-add="{{ path('update_quantity', {'id' : c.id}) }}" data-url="{{ path('ecommerce_cart_view') }}" /></td>
        <td>{{ c.priceHt|number_format(2, ',', ' ') }}€</td>
        <td>{{ c.price|number_format(2, ',', ' ') }}€</td>
        <td>{{ c.finalPriceHt|number_format(2, ',', ' ') }}€</td>
        <td>{{ c.finalPriceTtc|number_format(2, ',', ' ') }}€</td>
        <td><a class="bn bn-danger" href="{{ path('remove_from_cart', {'id' : c.id}) }}"><i class="fa-solid fa-trash"></i></a></td>
    </tr>
{% endmacro %}

{% macro cartLineTotal(cart) %}
    <tr class="product list-item">
        <td></td>
        <td>Total</td>
        <td>{{ cart.totalQuantity }}</td>
        <td>{{ cart.totalUnitaireHt|number_format(2, ',', ' ') }}€</td>
        <td>{{ cart.totalUnitaireTtc|number_format(2, ',', ' ') }}€</td>
        <td>{{ cart.totalHt|number_format(2, ',', ' ') }}€</td>
        <td>{{ cart.totalTtc|number_format(2, ',', ' ') }}€</td>
        <td></td>
    </tr>
{% endmacro %}

{% macro flashDisplay() %}
    {% for label, flashes in app.session.flashbag.all %}
        {% for message in flashes %}
            <div class="{{ label == "error" ? "flash-error" : "flash-success" }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}
{% endmacro %}


{% macro cardCategory(category) %}
    <div class="card-product" data-ecommerce-target="link" data-link="{{ path('app_product_list', {'id' : category.id}) }}">
        <div class="card-product-img" style="background-image: url({{ asset(category.firstPicture.path) }})"></div>
        <div class="card-product-descr">
            <p>{{ category.translate.title }}</p>
            <p>{{ category.translate.shortContent }}</p>
        </div>
    </div>
{% endmacro %}


{% macro breadcrumb(entity = null) %}
    <ul class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('app_homepage') }}"><i class="fa-solid fa-home"></i></a></li>
        {{ generateBreadcrumb(app.request, entity)|raw }}
    </ul>
{% endmacro %}

{% macro subMenu(cat) %}
    {% if cat.childrens|length > 0 %}
        <li class="dropdown-right-selected">
            <a href="{{ path('app_product_list', {'id': cat.id}) }}">{{ cat.translate.title }} <i class="fa-solid fa-caret-right"></i></a>
            <ul class="dropdown-content-right">
                {% for children in cat.childrens %}
                    {{ _self.subMenu(children) }}
                {% endfor %}
            </ul>
        </li>
    {% else %}
        <li class="dropdown-right-selected"><a href="{{ path('app_product_list', {'id': cat.id}) }}">{{ cat.translate.title }}</a></li>
    {% endif %}
{% endmacro %}


{% macro editProfileBtns(img = false) %}
    <div class="profile-edit" data-profile-target="pen">
        <div class="edit-btn pen">
            <i class="fa-solid fa-pen"></i>
        </div>
        {% if img == false %}
            <div class="edit-btn action">
                <i class="fa-solid fa-xmark" data-profile-target="cancel"></i>
                <i class="fa-solid fa-check" data-profile-target="validate"></i>
            </div>
        {% endif %}
    </div>
{% endmacro %}

{% macro attributes(attribute) %}
    <button class="attribute" data-ecommerce-target="attribute" data-parent="{{ attribute.productAttribute.translate.title|raw }}" data-attr="{{ attribute.id }}">
        <span>{{ attribute.translate.title|raw }}</span>
    </button>
{% endmacro %}

{% macro filter(productAttributes = null, category = null) %}
<div class="filter">
    <form  data-url="{{ path('app_product_list_view') }}">
        {% if category is not null %}
            <div class="filt-cont">
                {{ _self.filterSelectCategory("commerce.category.child"|trans, "category", category) }}
            </div>
        {% endif %}
        <div class="filt-cont">
            {{ _self.filterRange( "commerce.price"|trans,"price") }}
        </div>
        {% if productAttributes and productAttributes|length > 0 %}
            <div class="filt-cont">
                {% for pr in productAttributes %}
                   {{ _self.filterCheckbox(pr.translate.title, "attr_"~pr.id, pr.attributeItems) }}
                {% endfor %}
            </div>
        {% endif %}
    </form>
</div>
{% endmacro %}

{% macro filterRange(title, key) %}
    <label for="{{ key }}" class="small-title">{{ title }}</label>
    <div class="filter-range">
        <input type="number" name="{{ key }}_min" data-ecommerce-target="filter" /> -
        <input type="number" name="{{ key }}_max" data-ecommerce-target="filter" />
    </div>
{% endmacro %}

{% macro filterSelectCategory(title, key, entity) %}
    <label for="{{ key }}" class="small-title">{{ title }}</label>
    <div class="filter-select">
        <select name="{{ key }}" data-ecommerce-target="filter">
            <option value="{{ entity.firstParent.id }}">{{ entity.firstParent.translate.title }}</option>
            {% for e in entity.firstParent.childrens %}
                <option value="{{ e.id }}">{{ e.translate.title }}</option>
                {% if e.childrens %}
                    {{ _self.filterSelectChildren(e) }}
                {% endif %}
            {% endfor %}
        </select>
    </div>
{% endmacro %}

