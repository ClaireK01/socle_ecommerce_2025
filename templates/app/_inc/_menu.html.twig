                {% if 'ecommerce_' not in app.request.get('_route') and (app.request.get('_route') != "app_login" or app.request.get('_route') == "app_login" and (app.request.get('cart') is null)) %}
                    <div class="shop-icon-container">
                        <li><a href="#" {{ stimulus_action('ecommerce', 'cartPreviewElement')}} class="btn-cart-preview"><i class="fa-solid fa-cart-shopping"></i></a></li>
                        <span class="shop-count" data-ecommerce-target="shopcount">{{ getShopCount(app.request.session) }}</span>
                    </div>
                {% endif %}
                {% if app.user %}
                    <li><a href="{{ path('app_user') }}" class="bn bn-primary white">Mon Profil</a></li>
                    <li><a class="deco" href="{{ path('app_logout') }}">Se déconnecter</a></li>
                {% else %}
                    <li class="register-btn"><a href="{{ path('app_register') }}" class="bn bn-primary white">S'inscrire</a></li>
                    <li><a href="{{ path('app_login') }}" class="bn bn-primary white">Se Connecter</a></li>
                {% endif %}
            </div>
        </div>
