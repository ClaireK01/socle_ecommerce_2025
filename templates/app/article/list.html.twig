{% extends 'base.html.twig' %}
{% import 'app/macro.html.twig' as m %}


{% block content %}
    <section class="section">
        <h2 class="title">{{ "commerce.article.see"|trans }}</h2>
        <div class="list">
            {% for article in pagination %}
                {{ m.cardArticle(article) }}
            {% endfor %}
        </div>
        {{ knp_pagination_render(pagination) }}
    </section>
{% endblock %}