{% extends 'base.html.twig' %}
{% import 'app/macro.html.twig' as m %}

{% block intro %}
    <section class="hero">
        <div class="hero-content">
            <h1>Socle</h1>
            <p>Explore the finest collection of men's wear crafted to perfection.</p>
            <button class="cta-button">Shop Now</button>
        </div>
    </section>
{% endblock %}
{% block content %}
    <div class="sub-menu">
        <h2>{{ 'all.arrivals'|trans }}</h2>
        <div class="cont-cont-sub-menu-list"></div>
    </div>
    <section class="section products">
        <div class="product-highlight">
            <h2>{{ 'all.watch'|trans }}</h2>
            <div class="product-grid">
                <div class="swiper-product swiper-container" data-swipe="product">
                    <div class="swiper-wrapper">
                        {% for p in products %}
                            <div class="swiper-slide">
                                {{ m.cardProduct(p) }}
                            </div>
                        {% endfor %}
                    </div>
                    <div class="swiper-pagination-product"></div>
                    <div class="swiper-button-prev"></div>
                    <div class="swiper-button-next"></div>
                </div>
            </div>
        </div>
    </section>
    <section>
        <div class="spacer layer-top"></div>
        <div class="about">
            <div class="delayed">
                <h2>{{ "about.title"|trans }}</h2>
                <p>{{ "lorem"|trans }}</p>
                <a href="{{ path('app_presentation') }}"><button class="bn bn-primary white">{{ "all.seemore"|trans }} <i class="fa-solid fa-arrow-right"></i></button></a>
            </div>
        </div>
        <div class="spacer layer-bottom"></div>
    </section>
    <section class="section products">
        <div class="product-highlight">
            <h2>{{ 'all.grooming'|trans }}</h2>
            <div class="product-grid">
                <div class="swiper-highlights1 swiper-container" data-swipe="highlights1">
                    <div class="swiper-wrapper">
                        {% for p in hightlights1 %}
                            <div class="swiper-slide">
                                {{ m.cardProduct(p) }}
                            </div>
                        {% endfor %}
                    </div>
                    <div class="swiper-pagination-highlights1"></div>
                    <div class="swiper-button-prev"></div>
                    <div class="swiper-button-next"></div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
