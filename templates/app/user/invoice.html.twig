<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{{ 'all.invoice'|trans }}</title>
    </head>
    <style>
        body{
            position: relative;
        }

        .left {
            position: absolute;
            left: 100px;
        }

        .right{
            top: 100px;
            position: absolute;
            right: 100px;
            display: flex;
        }

        .right div{
            text-align: center;
        }

        .right-1{
            margin-right: 40px;
        }

        table{
            border-collapse: collapse;
        }

        thead{
            background-color: #b4afaf;
        }

        td, th{
            border-bottom: 1px solid black;
            padding: 10px;
            text-align: center;
        }

        .content-top{
            position: absolute;
            top: 300px;
            left: 100px;
        }
        .content{
            position: absolute;
            top: 450px;
            left: 100px;

        }

        .empty{
            border-bottom: none;
            padding: 10px 0 0 0;
        }

        .footer{
            position: absolute;
            top: 1000px;
            left: 100px;
            font-size: 0.8rem;

        }
    </style>
    <body>
        <div class="left">
            <p>
                {{ name }}<br>
                {{ address }}<br>
                {{ zipcode }}{{ city }} <br>
                Siret : {{ siret }}<br>
            </p>

        </div>

        <div class="right">
            <div class="right-1">
                <h3><strong>{{ "user.order.shipping"|trans }}</strong></h3>
                <p>
                    {{ order.facturationAddress.lastName }} {{ order.facturationAddress.firstName }}<br>
                    {{ order.facturationAddress.address }}<br>
                    {{ order.facturationAddress.code }} {{ order.facturationAddress.city }}<br>
                </p>
            </div>
            <div>
                <h3><strong>{{ "user.order.billing"|trans }}</strong></h3>
                <p>
                    {{ order.facturationAddress.lastName }} {{ order.facturationAddress.firstName }}<br>
                    {{ order.facturationAddress.address }}<br>
                    {{ order.facturationAddress.code }} {{ order.facturationAddress.city }}<br>
                </p>
            </div>
        </div>

        <div class="content-top">
            <p>Commande n°{{ order.number }}<br>le {{ order.createdAt|date('d/m/Y') }}</p>
            <h2>Facturation</h2>
        </div>
        <div class="content">
            <table>
                <thead>
                    <tr>
                        <th>{{'user.order.label'|trans}}</th>
                        <th>{{'user.order.quantity'|trans}}</th>
                        <th>{{'user.order.priceHT'|trans}}</th>
                        <th>{{'user.order.priceTTC'|trans}}</th>
                        <th>{{'user.order.vta'|trans}}</th>
                        <th>{{'user.order.finalPriceTTC'|trans}}</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        {% for cp in order.cardProducts %}
                            <td>{{cp.product.translate.title}}</td>
                            <td>{{cp.quantity}}</td>
                            <td>{{cp.priceHt|number_format(2, ',', ' ')}}€</td>
                            <td>{{cp.price|number_format(2, ',', ' ')}}€</td>
                            <td>{{cp.product.tva}}</td>
                            <td>{{cp.finalPriceTtc|number_format(2, ',', ' ')}}€</td>
                        {% endfor %}
                    </tr>
                    <tr>
                        <td class="empty"></td>
                        <td class="empty"></td>
                        <td class="empty"></td>
                        <td class="empty"></td>
                        <td class="empty"><strong>{{"user.order.totalht"|trans}}</strong></td>
                        <td class="empty">{{order.totalPriceHt|number_format(2, ',', ' ')}}€</td>
                    </tr>
                    <tr>
                        <td class="empty"></td>
                        <td class="empty"></td>
                        <td class="empty"></td>
                        <td class="empty"></td>
                        <td class="empty"><strong>{{"user.order.vta"|trans}}</strong></td>
                        <td class="empty">{{(order.totalPriceTtc - order.totalPriceHt)|number_format(2, ',', ' ')}}€</td>
                    </tr>
                    <tr>
                        <td class="empty"></td>
                        <td class="empty"></td>
                        <td class="empty"></td>
                        <td class="empty"></td>
                        <td class="empty"><strong>{{"user.order.total"|trans}}</strong></td>
                        <td class="empty">{{order.totalPriceTtc|number_format(2, ',', ' ')}}€</td>
                    </tr>
                </tbody>
            </table>
            <p>{{ 'user.order.paymentMethod'|trans }} : {{ order.paymentMethod.translate.title }}</p>
        </div>

        <div class="footer">
            <p class="small">{{ mention }}</p>
        </div>
    </body>
</html>