{% extends 'app/user/base_user.html.twig' %}
{% import 'admin/macro.html.twig' as m %}



{% block user_content %}
    <div class="order-infos">
        <div class="address card-order-infos">
            <span class="small-title">{{ 'commerce.address'|trans }}</span>
{#            <h3>{{ order.shippingAddress.label }}</h3>#}
            <div>
                <span><span class="lighten">{{ order.phone }}</span><br>
                {{ order.shippingAddressLine }}<br>
                {{ order.shippingCode}}, {{ order.shippingCity|upper }}</span>
            </div>
        </div>
        <div class="shipping card-order-infos">
            <span class="small-title">{{ 'commerce.shipping'|trans }}</span>
            <h3>{{ order.shipping.translate.title|raw }}</h3>
            <p>{{ order.shipping.translate.shortContent|raw }}</p>
        </div>
        <div class="payment card-order-infos">
            <span class="small-title">{{ 'commerce.payment'|trans }}</span>
            <h3>{{ order.paymentMethod.translate.title|raw }}</h3>
            <p>{{ order.paymentMethod.translate.shortContent|raw }}</p>
        </div>
    </div>
    <table class="table-products">
        {{ m.orderDisplay(order) }}
    </table>
    <div class="actions">
        <a href="{{ path('app_user_orders') }}"><button class="bn bn-primary">{{ 'all.previous'|trans }}</button></a>
        <a href="{{ path('app_user_invoice', {'id' : order.id}) }}"><button class="bn bn-primary"><i class="fa-solid fa-file-download"></i> {{ 'all.downloadInvoice'|trans }}</button></a>
        {% if order.status == constant('App\\Entity\\EcommerceOrder::CONFIRMED') %}
            <button {{ stimulus_action('popup', 'popupFormElement') }} data-url="{{ path('app_user_order_cancel', {'id' : order.id}) }}" class="bn bn-danger"><i class="fa-solid fa-trash"></i> {{ 'all.cancel'|trans }}</button>
        {% endif %}
    </div>
{% endblock %}