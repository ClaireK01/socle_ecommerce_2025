{% extends 'app/user/base_user.html.twig' %}

{% block user_content %}
    <div>
        <table class="table-products">
            <thead>
            <tr class="list-item">
                <th>{{ "user.order.number"|trans }}</th>
                <th>{{ "user.order.status"|trans }}</th>
                <th>{{ "user.order.totalht"|trans }}</th>
                <th>{{ "user.order.totalttc"|trans }}</th>
                <th>{{ "user.order.action"|trans }}</th>
            </tr>
            </thead>
            <tbody>
                {% for o in orders %}
                    <tr class=" list-item">
                        <td>{{ o.number }}</td>
                        <td>{{ o.statusLabel|raw }}</td>
                        <td>{{ o.totalHT|number_format(2, ',', ' ') }}€</td>
                        <td>{{ o.totalTTC|number_format(2, ',', ' ') }}€</td>
                        <td class="actions">
                            <a href="{{ path('app_user_order_show', {'id' : o.id}) }}"><button class="btn btn-warning"><i class="fa-solid fa-eye"></i></button></a>
                            <a href="{{ path('app_user_invoice', {'id' : o.id}) }}"><button class="btn btn-warning"><i class="fa-solid fa-file-download"></i></button></a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}