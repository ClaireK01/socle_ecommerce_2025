{% extends 'app/user/base_user.html.twig' %}

{% block user_content %}
    <div>
        <table class="table-products">
            <thead>
            <tr class="list-item">
                <th>{{ "user.order.number"|trans }}</th>
                <th>{{ "user.order.status"|trans }}</th>
                <th>{{ "user.order.action"|trans }}</th>
            </tr>
            </thead>
            <tbody>
                {% for o in app.user.requests %}
                    <tr class=" list-item">
                        <td>{{ o.number }}</td>
                        <td>{{ o.statusLabel|raw }}</td>
                        <td class="actions">
                            <a href="{{ path('app_user_request_show', {'id' : o.id}) }}"><button class="bn bn-primary"><i class="fa-solid fa-eye"></i></button></a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}