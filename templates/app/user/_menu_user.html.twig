{% import 'app/macro.html.twig' as m %}

<ul class="user-menu">
   <a class="{{ app.request.get("_route") == "app_user" ? "selected" : "" }}" href="{{ path('app_user') }}"><li>{{ "user.infos"|trans }}</li></a>
   <a href="{{ path('app_user_message') }}" class="{{ app.request.get("_route") == "app_user_message" ? "selected" : "" }}"><li>{{ "user.message"|trans }}</li></a>
   <a href="{{ path('app_user_orders') }}" class="{{ "app_user_order" in app.request.get("_route") ? "selected" : "" }}"><li>{{ "user.orders"|trans }}</li></a>
   {% if attribute(app.user, 'getRequests') is defined %}
      <a href="{{ path('app_user_request') }}" class="{{ "app_user_request" in app.request.get("_route") ? "selected" : "" }}"><li>{{ "user.request"|trans }}</li></a>
   {% endif %}
</ul>