{% for c in clients %}{% endfor %}
{% if user %}
{% for client in users %}
    {% if client != user %}
        <hr>
        <div class="contact-list-item">
            <div class="contact-profile-pic">
            </div>
            <div class="contact-infos">
                    {{ client.email }}
                    <span class="tag" style="color:{{ client.status == 0 ? 'grey' : 'green' }}"> &#x2022; {{ client.status == 0 ? 'Non connecté' : 'Connecté'}}</span>
                <button class="btn btn-success btn-sendmessage" data-message="{{ path('app_user_convo', {'from' : user.id, 'to':client.id}) }}">Envoyer un message</button>
            </div>
        </div>
    {% endif %}
{% endfor %}
{% endif %}